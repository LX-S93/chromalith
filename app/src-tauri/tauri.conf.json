{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chromalith",
  "version": "0.11.0",
  "identifier": "de.lxs93.chromalith",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chromalith",
        "width": 1500,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "dragDropEnabled": false,
        "backgroundColor": "#0e0f13"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Farbige Reliefbilder aus Filament-Schichten",
    "windows": {
      "nsis": { "languages": ["German"], "installMode": "currentUser" }
    }
  }
}
